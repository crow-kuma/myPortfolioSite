{
  "name": "portfolioAstro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.scss\" \"**/*.astro\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" \"src/**/*.scss\" \"**/*.astro\" --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "8.6.2",
    "@sanity/vision": "^6.15.0",
    "astro": "^7.3.5",
    "astro-portabletext": "1.0.1",
    "lightgallery": "^2.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.3.0",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@sanity/astro": {
      "astro": "$astro"
    }
  }
